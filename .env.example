# Enquiry API (public URL; POST /api/lead)
VITE_API_BASE_URL=http://localhost:3001

# Custom Bókun pages. Server-only credentials; NEVER use a VITE_ prefix for keys.
BOKUN_API_BASE=https://api.bokun.is
BOKUN_ACCESS_KEY=
BOKUN_SECRET_KEY=
BOKUN_CURRENCY=USD
# Exact public frontend origin for payment return URLs (use localhost in development)
PUBLIC_SITE_URL=http://localhost:5173
# Only enable when your booking channel explicitly allows booking without online payment
BOKUN_ALLOW_PAY_LATER=false
# Private persistent checkout records (single backend process); defaults to .bokun-checkouts
BOKUN_STATE_DIRECTORY=
# Leave blank for same-origin /api; set to backend origin when hosted separately
VITE_BOKUN_API_BASE_URL=

# Server-only SMTP settings for booking email verification. Never use VITE_ prefixes.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Dove Journeys <bookings@example.com>"

# Reserved for a future live PayPal integration; current server is a mock
VITE_PAYPAL_CLIENT_ID=

# Public contact details — replace before launch
VITE_EMAIL_SUPPORT=admin@dovejourneys.com
# Leave blank to hide WhatsApp until you have a business number
VITE_WHATSAPP_NUMBER=+263789276807
VITE_WHATSAPP_MESSAGE="Hi, I want to plan a journey with Dove Journeys"

# Server-only administrator recipients (comma-separated); reserved for email delivery
# Never prefix private administrator addresses with VITE_.
ADMIN_EMAILS=admin@dovejourneys.com
PORT=3001

# Website developer contact for the footer credit
VITE_AXENTRA_WHATSAPP_NUMBER=+263789276807
